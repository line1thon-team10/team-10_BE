Project pirochim {
  database_type: 'PostgreSQL'
  Note: '2026-11-12 단순화 반영 ERD / OpenAPI 계약 0.7.0. 요구사항 v2 + 최신 와이어프레임 + AI 확인 요청 전 항목 구현 전제. 규칙·출처는 ERD-분석.md, 현재 구조·이월 배치의 부분 유일 인덱스는 erd-constraints.sql 참조. 전체 마이그레이션은 아님.'
}

// ON / NF: 익명 사용자, 과목, 목표, 온보딩
Table users {
  id uuid [pk, note: '익명 사용자 식별자. 인증 비밀값으로 사용하지 않음']
  timezone varchar [not null, default: 'Asia/Seoul']
  onboarding_status varchar [not null, default: 'draft', note: 'draft / completed. 최초 계획 승인 때 completed']
  demo_date date [note: '데모 전용 가상 날짜. 일반 사용자는 null']
  last_assessed_date date [note: '자정 판정 완료일. 미접속 기간을 순서대로 처리한 뒤 갱신']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table subjects {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  code varchar [not null, note: '백엔드 발급 과목 코드. DS / OS / NW 등; 사용자 내 유일']
  name varchar [not null]
  color varchar [not null, note: '#RRGGBB. 파랑·남색·보라 계열. 상태 색과 분리']
  status varchar [not null, default: 'draft', note: 'draft / active / archived. 추가 승인 전 draft, 삭제·시험 종료는 보관']
  archive_reason varchar [note: 'exam_finished / user_removed']
  archived_at timestamptz
  minutes_per_page decimal [not null, default: 2.5, note: '현재 승인된 속도 기준. P4 반영 시에만 갱신']
  calibrated_at timestamptz
  exam_name varchar
  exam_at timestamptz
  exam_date date [note: '과목당 목표 시험 1개. 미수집은 null']
  exam_scope_text text
  exam_weight_percent decimal [note: '0~100 표시용']
  raw_goal text [note: '목표 미수집은 null']
  target_grade varchar
  emphasized_content text
  passing_criteria text
  grade_criteria text
  grading_weights text
  other_exam_info text
  target_score decimal [note: '0~100. A+ 90 / B+ 80 / 통과 60 기본 매핑']
  goal_confirmed_at timestamptz [note: '목표/강조 변경 시 null, 확인/승인 시 설정']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (user_id, code) [unique] }
}

Table onboarding_messages {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  change_request_id uuid [ref: > plan_change_requests.id, note: '계획 중 과목 추가 대화면 연결. 최초 온보딩은 null']
  role varchar [not null, note: 'user / ai']
  text text [not null]
  chips jsonb [note: '빠른 선택 칩 배열']
  created_at timestamptz [not null]
  indexes { (user_id, created_at) }
}

// ON-04~08: 승인된 일정과 반복 회차 예외
Table calendar_events {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  subject_id uuid [ref: > subjects.id]
  event_type varchar [not null, default: 'other', note: 'class / job / meet / exam / other']
  title varchar [not null]
  starts_at timestamptz [not null, note: '반복이면 첫 회 시작']
  ends_at timestamptz [not null]
  recurrence_rule text [note: 'RRULE. 비반복은 null']
  recurrence_until date
  source_text text
  revision int [not null, default: 1, note: '변경 미리보기의 기준 버전 검증']
  deleted_at timestamptz [note: '삭제 이력. 겹침·빈 시간 계산에서 제외']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (user_id, starts_at) }
}

Table calendar_event_exceptions [note: 'single은 시간 이동/취소만. future 수정 시 원래 날짜가 새 규칙에도 있으면 같은 ID로 이전하며 이동 시각/취소를 유지. 사라질 예외는 후보에 표시 후 승인 시 제거. future 삭제는 기존 규칙 종료만 하며 새 규칙을 만들지 않음.'] {
  id uuid [pk]
  event_id uuid [not null, ref: > calendar_events.id]
  occurrence_date date [not null, note: '원래 회차의 사용자 현지 날짜']
  kind varchar [not null, note: 'cancelled / moved']
  new_starts_at timestamptz
  new_ends_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (event_id, occurrence_date) [unique] }
}

// PDF-01~08 / AI 확인 1~4, 11~13
Table materials {
  id uuid [pk]
  subject_id uuid [not null, ref: > subjects.id]
  original_name varchar [not null]
  source_format varchar [not null, note: 'pdf / ppt / pptx. PPT도 내부 학습 자료는 PDF로 변환']
  original_storage_key text [note: '업로드 원본. 삭제하면 null']
  storage_key text [note: '열람·근거 페이지 기준인 정규화 PDF. 삭제하면 null']
  sha256 varchar [not null, note: '업로드 파일 해시. 같은 사용자 자료 재분석 방지']
  page_count int [note: '정규화 PDF의 실제 페이지 수. 시연용 허구 페이지 수를 저장하지 않음']
  extraction_method varchar [note: 'text / ocr / manual']
  ocr_confidence decimal [note: 'OCR 품질 0~1; 판별 임계값은 분석기 설정']
  analysis_version varchar [not null, note: '파서·프롬프트·출력 스키마 버전']
  analysis_status varchar [not null, default: 'pending', note: 'pending / processing / succeeded / failed / manual']
  analysis_stage varchar [note: 'convert / text / outline / concepts. 기본 PDF 화면은 뒤의 3단계']
  error_message text
  is_fallback boolean [not null, default: false]
  quiz_enabled boolean [not null, default: false, note: '분석 검증 후 true. 낮은 OCR 품질·수동 목차는 false']
  quiz_disabled_reason varchar [note: 'low_ocr_confidence / manual_outline / analysis_failed 등']
  question_generation_status varchar [not null, default: 'pending', note: 'pending / running / ready / failed / disabled. 현재 구조의 포함 단원마다 유효 low 10개 이상일 때 ready. 구조 변경은 pending+새 작업을 원자 저장, 대상 없으면 disabled. 오래된 작업은 상태 변경 금지']
  original_deleted_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { (subject_id, sha256, analysis_version) [unique] }
}

Table units [note: '현재 행만 (material_id, sort_order) 유일. 제목·순서·난이도·예상 시간·in_scope 정정은 ID 유지. 페이지/분량 기준·개념 구성의 의미 변경만 영향 단원을 교체. retired_at IS NULL 부분 인덱스는 erd-constraints.sql에 정의.'] {
  id uuid [pk]
  material_id uuid [not null, ref: > materials.id]
  code varchar [not null, note: 'DS2 등. 과목 내 단원 번호를 발급해 여러 PDF에서도 충돌 방지']
  title varchar [not null]
  sort_order int [not null]
  quantity_basis varchar [not null, default: 'page', note: 'page / time. 수동 목차의 약 2시간 입력 지원']
  start_page int [note: 'page 기준 필수. 시간만 아는 수동 목차는 null']
  end_page int
  estimated_minutes int [note: 'time 기준 필수. 실제 측정 시간이 아닌 계획 분량']
  difficulty varchar [note: 'low / mid / high']
  in_scope boolean [not null, default: true]
  evidence jsonb [note: 'S4 단원 분할 근거 문장 목록']
  emphasis_weight decimal [not null, default: 1.0, note: '보통 1.0 / 사용자 확인 강조 1.5']
  emphasis_reason text
  mastery_score decimal [note: '첫 퀴즈 전 null, 표시 점수 최대 99']
  mastery_level varchar [note: 'risk / shaky / stable. 첫 퀴즈 전 null']
  recovery_mode boolean [not null, default: false]
  recovery_started_at timestamptz
  mastery_updated_at timestamptz [note: '이해도 갱신 시각. API의 첫 미평가 updatedAt은 created_at']
  retired_at timestamptz [note: '참조된 단원은 물리 삭제 대신 비활성화; 기존 기록·근거 보존']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { material_id }
}

Table concepts [note: '현재 행만 단원 내 code/sort_order 유일. 제목·순서 정정은 ID 유지. 페이지·소속 단원 변경은 의미 변경으로 해당 단원 구조를 교체. 교체 시 retire 후 같은 코드·순서 사용 가능. erd-constraints.sql 참조.'] {
  id uuid [pk]
  unit_id uuid [not null, ref: > units.id]
  code varchar [not null, note: 'DS2-1 형식. AI 코드는 UUID와 별도, 단원 내 유일']
  title varchar [not null]
  sort_order int [not null]
  start_page int [not null]
  end_page int [not null]
  difficulty varchar [note: 'low / mid / high']
  estimated_minutes int
  in_scope boolean [not null, default: true, note: '단원도 포함 상태여야 실제 시험 범위']
  retired_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes { unit_id }
}

// PL / RC: 승인 계획, 승인 전 입력과 복구 근거, 후보
Table plans [note: '사용자당 승인 계획 1개. 첫 승인 때 생성, 이후 같은 ID의 revision 증가. 승인 전 계획 행은 없으며 후보 changes로만 미리보기. 기록/태스크/블록 ID는 보존.'] {
  id uuid [pk]
  user_id uuid [not null, unique, ref: > users.id]
  revision int [not null, default: 1, note: '배치/기록/입력 변경 시 증가. 오래된 후보 승인 방지']
  created_at timestamptz [not null]
  approved_at timestamptz [not null]
}

Table plan_change_requests [note: 'S5-1·S6-4·S13·S14·P4·P5 공통. 확인 전 일정·목표·범위·속도는 input_payload에만 보관. 스키마와 소유권 검증 필수.'] {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  base_plan_id uuid [ref: > plans.id, note: '첫 계획 승인 전 또는 일정 전용이면 null']
  base_plan_revision int
  base_proposal_id uuid [ref: > plan_proposals.id, note: '첫 승인 전 재분배의 기준 후보. 기준 계획 ID/revision과 동시 사용 금지']
  accepted_proposal_id uuid [ref: > plan_proposals.id, note: 'accepted일 때만 같은 요청의 선택 후보 ID. 후보 상태는 여기서 파생']
  recovery_context jsonb [note: 'P2 판정 스냅샷: assessedDate, subjects별 overduePages/scopePages/scheduledStudyDays/dailyAveragePages/thresholdPages. 별도 복구 상태 없음']
  last_presented_at timestamptz [note: 'P2 나중에 보기 시각. 요청 ready 유지']
  kind varchar [not null, note: 'initial / redistribute / schedule_add / schedule_edit / schedule_delete / add_plan / subject_add / subject_archive / scope_change / exam_change / goal_change / extra_time / rest_today / postpone_task / regenerate / speed_adjust / free_slot / recovery']
  status varchar [not null, note: 'draft / needs_input / ready / accepted / rejected / stale']
  request_text text
  input_payload jsonb [not null, note: 'schemaVersion + 대상 ID·버전·변경 전후 값. S5 manualAllocations(subjectId,totalMinutes), S13 goal(daily_minutes/total_pages), 반복 요일·기간, S14 수정값 포함. schedule_add/edit는 /events에서 생성한 정규화 명령']
  followup_question text [note: '애매한 요청에만 질문 1개']
  followup_answer text
  effective_date date [note: '목표 변경은 내일부터 등 적용 시작일']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  decided_at timestamptz
  indexes { (user_id, status) }
}

Table plan_proposals {
  id uuid [pk]
  request_id uuid [not null, ref: > plan_change_requests.id, note: '같은 요청의 후보 중 최대 하나만 승인']
  proposal_type varchar [not null, note: 'initial / more_time / reduce_scope / compress / revision / schedule_change / free_slot_rest / free_slot_pull_carryover / free_slot_pull_next / speed_adjust / add_plan / manage']
  description text [not null]
  changes jsonb [not null, note: 'PlanChanges 불변 스냅샷: plannedTasks 전체, outlineChanges 전체 구조와 교체 매핑, manualAllocations 수동 배정 분, 일정/범위/목표 patch. 예약 UUID는 승인 전 FK 행으로 저장하지 않음. 차이 배열은 같은 스냅샷에서 계산. 계획 헤더를 포함한 새 도메인 행은 승인 때 원자 생성']
  created_at timestamptz [not null]
}

Table study_blocks [note: '책 블록의 지속 ID. 같은 작업의 이월·버전 복사는 이 ID 공유. 기록된 블록은 삭제하지 않고 현재 등급으로 표시.'] {
  id uuid [pk]
  subject_id uuid [not null, ref: > subjects.id]
  unit_id uuid [ref: > units.id, note: '여러 단원 총복습은 null, 과목 공통 복습 블록으로 표시']
  task_type varchar [not null, note: 'study / review / remedial']
  stacked_at timestamptz [note: '첫 완료 기록 때 설정. 부분 완료는 별도 진행 상태로 표시']
  created_at timestamptz [not null]
}

Table study_tasks [note: '일반 이월은 같은 계획/블록에 이전 carried_over 행과 새 planned 행을 보존. planned/partial만 (plan_id, block_id) 유일; erd-constraints.sql 참조. 후보 태스크는 승인 전 이 표에 저장하지 않음.'] {
  id uuid [pk]
  plan_id uuid [ref: > plans.id, note: 'null은 계획 밖 재학습 완료 이력. review만 허용, 계획 편입/집중 시작/자동 이월/P2와 계획 대비 집계에서 제외. 소유권은 subject→user']
  subject_id uuid [not null, ref: > subjects.id]
  block_id uuid [not null, ref: > study_blocks.id]
  origin_task_id uuid [ref: > study_tasks.id, note: '이미 저장된 선행 태스크만 참조. 최초 승인 전 draft 재분배는 null이며 예약 block ID만 유지']
  task_type varchar [not null, note: 'study / review / remedial. remedial은 진도율 제외, 미완료 의무 삭제·제외 금지. 기록 정정 후 불필요한 미시작 자동 이월 배치 취소는 허용']
  title varchar [not null]
  scheduled_date date [not null, note: '계획 태스크는 배치일, 계획 밖 review 이력은 최초 완료 기록일']
  starts_at timestamptz
  ends_at timestamptz
  estimated_minutes int [not null, note: '초기 분할 15~60분. 측정·보정값과 구분. 집중 시작 후 해당 행은 고정, 미래 조정은 새 배치로 생성']
  placement_reason text
  status varchar [not null, note: 'planned / partial / completed / missed / carried_over / excluded. API에서 todo / partial / done / none으로 변환']
  created_at timestamptz [not null]
  indexes {
    (plan_id, scheduled_date)
    (plan_id, block_id)
    origin_task_id
  }
}

Table study_task_ranges [note: '태스크의 실제 자료 범위. 보충의 비연속 오답 개념·여러 단원 총복습 지원. start/end_page는 API에서 이 표로 조립.'] {
  id uuid [pk]
  task_id uuid [not null, ref: > study_tasks.id]
  unit_id uuid [not null, ref: > units.id]
  concept_id uuid [ref: > concepts.id]
  start_page int
  end_page int
  planned_minutes int [note: '페이지 없는 수동 목차의 계획 분량. 이때 start/end_page는 모두 null']
  sort_order int [not null]
  indexes { (task_id, sort_order) [unique] }
}

Table daily_plan_totals [note: '전체 달성률·월간의 날짜별 분모. 퀴즈 70%는 이 총량을 그대로 쓰지 않고 해당 날짜 태스크/범위/자료에서 출제 가능한 페이지 계획·완료량만 계산. 당일 승인 변경까지만 갱신, 자정 확정 후 이월·새 버전으로 덮어쓰지 않음. 완료량은 기록에서 계산.'] {
  user_id uuid [not null, ref: > users.id]
  subject_id uuid [not null, ref: > subjects.id]
  study_date date [not null]
  plan_id uuid [not null, ref: > plans.id]
  planned_new_pages int [not null, note: 'study 범위의 중복 없는 계획 페이지. 새 범위 진도 집계용이며 하루 70% 분모가 아님']
  planned_total_pages int [not null, note: '복습·보충 포함 학습 회차별 계획량. 전체 하루 달성·월간 책 높이의 분모. 퀴즈는 quiz_enabled인 페이지 자료만 별도 집계']
  planned_unpaged_minutes int [not null, default: 0, note: '페이지 없는 수동 범위 계획량. 페이지 분모에 환산하지 않음']
  finalized_at timestamptz
  updated_at timestamptz [not null]
  indexes { (user_id, subject_id, study_date) [pk] }
}

// HM / PL-07: 집중 측정과 페이지 기록
Table study_sessions {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  task_id uuid [not null, ref: > study_tasks.id]
  status varchar [not null, note: 'running / paused / ended / auto_stopped']
  started_at timestamptz [not null]
  paused_at timestamptz
  check_prompted_at timestamptz [note: '현재 확인 대기 시각. 응답/멈춤/종료 때 null. 10분 기한 검사는 상태 변경 전에 수행']
  last_confirmed_elapsed_seconds int [not null, default: 0, note: '마지막 확인 당시 순공부 초. 다음 확인은 이 값 + 고정 task 예상 초의 2배. 확인 대기 중 pause도 현재 순공부 초를 저장. 일반 pause는 유지']
  ended_at timestamptz [note: '10분 무응답이면 실제 정지는 확인 알림 시각으로 소급']
  measured_seconds int [note: '서버가 segments 합계로 확정. 분 표시는 응답에서 변환']
  excluded_from_calibration boolean [not null, default: false, note: 'auto_stopped는 true']
  study_date date [not null, note: '시작 시 사용자/데모 날짜. 일반 시간은 사용자 자정에서 분할, 데모는 이 날짜에 귀속. running/paused 동안 demo 날짜 전환·seed는 409로 거절']
  created_at timestamptz [not null]
  indexes { (user_id, study_date) }
}

Table study_session_segments [note: '시작·재개마다 순공부 구간 생성, 멈춤·종료 때 닫음. 자정 전후와 멈춤 시간을 정확히 집계.'] {
  id uuid [pk]
  session_id uuid [not null, ref: > study_sessions.id]
  sort_order int [not null]
  started_at timestamptz [not null]
  ended_at timestamptz
  indexes { (session_id, sort_order) [unique] }
}

Table study_records [note: '완료·부분·못 함을 모두 저장. 페이지 수정 시 ranges를 교체하고 이월·진도·집계를 재계산. 시간은 세션에서만 읽음. plan_id=null인 review는 세션 없음, 계획과 별개인 재학습 이력. 정정·부족분 추가는 회독 근거만 재판정하고 자동 이월/새 의무를 만들지 않음.'] {
  id uuid [pk]
  task_id uuid [not null, ref: > study_tasks.id]
  session_id uuid [unique, ref: > study_sessions.id, note: '기록하기 직행이면 null. 한 세션을 여러 기록 시간으로 중복 합산 금지']
  result varchar [not null, note: 'completed / partial / missed']
  natural_text text
  incomplete_reason varchar [note: '선택 입력: time_shortage / difficult_content / unexpected_schedule / other']
  reason_text text
  recorded_at timestamptz [not null]
  study_date date [not null, note: '사용자 시간대 또는 데모 기준 날짜']
  updated_at timestamptz [not null]
  indexes { (task_id, study_date) }
}

Table study_record_ranges {
  id uuid [pk]
  record_id uuid [not null, ref: > study_records.id]
  unit_id uuid [not null, ref: > units.id]
  start_page int
  end_page int
  completed_planned_minutes int [note: '시간 기반 수동 범위의 완료 명목 분량(정수 분, 1 이상). 소수 입력 거절, 남은 계획량 이하. 측정 시간·속도 보정에 사용 금지']
  indexes { record_id }
}

Table speed_calibrations [note: '최근 3일 유효 측정 + 완료 페이지로 만든 P4 제안. applied만 과목 기준값을 갱신.'] {
  id uuid [pk]
  subject_id uuid [not null, ref: > subjects.id]
  notice_date date [not null]
  window_start date [not null]
  window_end date [not null]
  measured_seconds int [not null]
  completed_pages int [not null]
  previous_minutes_per_page decimal [not null]
  proposed_minutes_per_page decimal [not null]
  status varchar [not null, note: 'pending / applied / dismissed / stale']
  change_request_id uuid [unique, ref: > plan_change_requests.id]
  created_at timestamptz [not null]
  decided_at timestamptz
  indexes { (subject_id, notice_date) [unique] }
}

// LV / RV: 점수·회독 이력
Table mastery_history {
  id uuid [pk]
  unit_id uuid [not null, ref: > units.id]
  quiz_session_id uuid [not null, ref: > quiz_sessions.id]
  previous_score decimal [note: '첫 퀴즈 전 null. P3 변화 표시용']
  previous_level varchar
  raw_score decimal [not null, note: '계산식 결과. 회복 상한·등급 제한 적용 전']
  score decimal [not null, note: '제한 적용 후 표시 점수. 현재 최대 99']
  level varchar [not null, note: 'risk / shaky / stable']
  recovery_mode boolean [not null]
  daily_increase_limit int [note: '회복 모드 5 또는 15. 적용 근거를 고정']
  recorded_date date [not null]
  created_at timestamptz [not null]
  indexes {
    (unit_id, quiz_session_id) [unique]
    (unit_id, recorded_date)
  }
}

Table learning_passes [note: 'initial/remedial 자동, full_relearn만 명시적 완료/보완 등록. 단원 잠금 아래 근거 소비·범위·중복 검증. invalidated_at이 null인 근거만 회독 자격에 포함.'] {
  id uuid [pk]
  unit_id uuid [not null, ref: > units.id]
  pass_number int [not null]
  completion_kind varchar [not null, note: 'initial / remedial / full_relearn. v2 보충 완료는 2회독 자격 부여']
  source_task_id uuid [ref: > study_tasks.id]
  evidence_key varchar [not null, note: '서버 생성 불변 키. initial=initial, remedial=block UUID, full_relearn은 기록 방식=최초 정렬 recordIds 해시, 직접 방식=direct:SHA256(Idempotency-Key). 단원/종류 내 유일']
  evidence_snapshot jsonb [not null, note: 'schemaVersion 문자열 1, recordIds, requiredRanges(단원/페이지 또는 명목 분량). 당시 요구 범위를 고정. 직접 완료는 directRequestHash도 보존하여 같은 키의 다른 입력을 거절. 기록 정정 때 현재 ranges와 비교. 무효 회독 보완은 같은 행의 recordIds만 기존 집합에 추가, key/범위/순번/완료일 유지. 단원별로 다른 회독에서 소비된 기록 재사용 금지']
  completed_at timestamptz [not null]
  completed_date date [not null]
  invalidated_at timestamptz [note: '기록 정정으로 완료 범위가 부족해진 시각. 이력·기존 퀴즈 결과는 보존하고 자격만 재판정']
  note text [note: '완료 범위와 판정 근거']
  indexes {
    (unit_id, pass_number) [unique]
    (unit_id, completion_kind, evidence_key) [unique]
  }
}

// QZ / RV: 원본 문제, 구성, 확신·채점, 근거
Table questions [note: '구조 교체 뒤 과거 문항을 새 단원/개념에 재연결하지 않음. 현재 출제 범위·실제 근거가 검증된 문항만 준비도에 포함.'] {
  id uuid [pk]
  unit_id uuid [not null, ref: > units.id]
  concept_id uuid [ref: > concepts.id, note: 'AI 생성 문항은 필수. 수동·구시드는 null 허용']
  code varchar [note: 'DS2-01 등 외부 문항 코드. UUID와 구분']
  type varchar [not null, note: 'choice / ox / short / essay']
  difficulty varchar [not null, note: 'low / mid / high']
  prompt text [not null]
  choices jsonb [note: 'choice는 고유 ID와 비어 있지 않은 문장의 보기 2개 이상, ox는 정확히 2개. short/essay는 없음. API 결과도 같은 ID를 사용']
  correct_answer text [not null, note: '서술형은 모범 답안. 진행 중 API에는 비공개']
  explanation text [note: '출제 가능한 문항은 비어 있지 않은 해설 필수. 결과 화면에서만 공개']
  origin varchar [not null, default: 'pregenerated', note: 'pregenerated / generated / seed']
  generation_version varchar
  created_at timestamptz [not null]
  indexes {
    unit_id
    concept_id
    (unit_id, code) [unique]
  }
}

Table question_sources [note: '출제 가능한 문항은 근거 1개 이상. 각 근거는 비어 있지 않은 quote 또는 highlight 필수. 태그만으로 페이지 번호를 추측하지 않고 실제 PDF와 연결.'] {
  id uuid [pk]
  question_id uuid [not null, ref: > questions.id]
  material_id uuid [not null, ref: > materials.id]
  start_page int [not null]
  end_page int [not null]
  quote text [note: '근거 문장. 원본 삭제 시에도 해설 근거 보존']
  highlight jsonb [note: 'schemaVersion + 페이지별 문장 또는 정규화 좌표 배열']
  indexes { question_id }
}

Table quiz_sessions [note: '동일 날짜/과목에 제출 완료 배치와 후속 daily 공존 가능. ready/in_progress 배치에만 새 문항 병합; 제출한 답·결과는 불변. submitted/carried_over는 닫힌 세션. 이월 시 답한 시도만 원본에서 확정·결과 공개하고 미풀이만 다음 퀴즈로 연결. 대표 채점 작업은 ai_jobs의 essay_grade/quiz_session 대상 하나. 배정은 사용자 잠금으로 중복 방지.'] {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  subject_id uuid [ref: > subjects.id, note: '오늘의 퀴즈는 과목별. 여러 과목 문제 뽑기는 null']
  parent_quiz_session_id uuid [ref: > quiz_sessions.id, note: '더 풀기의 원래 세션']
  type varchar [not null, note: 'daily / extra / review / practice']
  quiz_date date [not null]
  status varchar [not null, note: 'generating / ready / in_progress / submitted / carried_over / failed']
  selected_difficulty varchar [note: 'low / mid / high. practice는 요청 전체 난이도를 한 번 저장. 선택 범위에 1회독이 섞이면 전체 low. daily 이월/취약 혼합은 item 실제 난이도 사용']
  requested_question_count int [note: 'practice만 1~50, 기본 10. 그 외 null. 실제 수는 quiz_items 개수이며 fallback은 min(요청 수,5)']
  distribution varchar [note: 'weak_first / balanced. practice 기본 weak_first, 그 외 null. 재시도에도 유지']
  current_position int [not null, default: 0, note: '한 문제씩 진행·새로고침 복원용, 0부터']
  grading_status varchar [not null, default: 'pending', note: 'pending / processing / completed / failed']
  is_fallback boolean [not null, default: false]
  created_at timestamptz [not null]
  submitted_at timestamptz [note: '사용자의 명시적 제출 시각. 이월 확정은 null']
  finalized_at timestamptz [note: '명시적 제출 또는 이월 확정 시각. 답 0개 이월도 기록; 이때 채점 작업·점수·P3 없음']
  graded_at timestamptz [note: '채점 완료 후 단원 점수 반영 및 P3 알림 1회 생성']
  indexes { (user_id, quiz_date, type) }
}

Table quiz_scopes [note: '문제 뽑기의 선택 범위 및 더 풀기 단원. 난이도는 quiz_sessions.selected_difficulty에서 조회하며 범위별 중복 저장하지 않음. 실제 문항은 이 범위와 완료·시험범위 조건을 검증.'] {
  id uuid [pk]
  quiz_session_id uuid [not null, ref: > quiz_sessions.id]
  unit_id uuid [not null, ref: > units.id]
  concept_id uuid [ref: > concepts.id, note: 'S10 선택 개념 제한. 여러 개념은 scope 여러 행. null이면 페이지 범위 내 포함 개념 전체; 지정 시 페이지와 개념의 교집합']
  start_page int [not null]
  end_page int [not null]
  indexes { quiz_session_id }
}

Table quiz_items {
  id uuid [pk]
  quiz_session_id uuid [not null, ref: > quiz_sessions.id]
  question_id uuid [not null, ref: > questions.id]
  origin_quiz_item_id uuid [ref: > quiz_items.id, note: '미풀이를 넘긴 직전 퀴즈의 문항. API originQuizId는 그 문항의 quiz_session_id로 조립. 최초 출제일은 original_quiz_date. 답한 문항은 복제·재채점하지 않음']
  sort_order int [not null]
  inclusion_reason varchar [not null, note: 'new / weak / carried_over / practice / extra']
  original_quiz_date date
  indexes {
    (quiz_session_id, sort_order) [unique]
    (quiz_session_id, question_id) [unique]
  }
}

Table quiz_attempts {
  id uuid [pk]
  quiz_item_id uuid [not null, unique, ref: > quiz_items.id]
  answer text [not null]
  confidence varchar [not null, note: 'sure / unsure. 선택 없이는 다음 불가']
  is_correct boolean [note: '서술형 채점 전 null']
  grading_status varchar [not null, note: 'pending / graded / failed / fallback']
  essay_score int [note: '0~100. 85 이상만 정답; 중간 부분정답 점수는 이해도에 직접 사용하지 않음']
  feedback text
  got_points jsonb [note: '서술형에서 맞은 부분 문장 목록']
  missing_points jsonb [note: '서술형에서 빠진 부분 문장 목록']
  answered_at timestamptz [not null]
  answered_date date [not null]
  finalized_at timestamptz [note: '제출 또는 이월 확정 시각. 확정된 원본 답만 점수 집계']
  graded_at timestamptz
  mastery_applied_at timestamptz [note: '원본 답의 이해도 반영 완료 시각. 이월·중복 제출 시 재적용 금지']
}

Table weak_questions [note: 'API 목록은 questions의 prompt/type/choices를 조인하고 최근 확정 시도만 lastResult로 제공. 문항 본문을 중복 저장하지 않음.'] {
  question_id uuid [pk, ref: > questions.id]
  status varchar [not null, note: 'active / resolved']
  review_step int [not null, default: 0, note: '0 / 1 / 2. 확실 정답을 1일 후, 이어 3일 후에 받으면 해제']
  next_review_date date [note: '그날 과목 퀴즈가 없으면 다음 과목 퀴즈까지 유지']
  last_weak_at timestamptz [not null]
  resolved_at timestamptz
}

// BK: 날짜·과목·단원·퀴즈별 재노출 방지
Table user_notices {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  dedupe_key varchar [not null, note: 'day_summary:날짜 / speed_alert:과목:날짜 / unit_complete:단원:회독 / recovery:단원:회복이력 / quiz_result:퀴즈 등']
  notice_type varchar [not null, note: 'day_summary / speed_alert / unit_complete / recovery / quiz_result']
  subject_id uuid [ref: > subjects.id]
  unit_id uuid [ref: > units.id]
  quiz_session_id uuid [ref: > quiz_sessions.id]
  notice_date date [not null]
  status varchar [not null, note: 'pending / shown / dismissed / applied']
  payload jsonb [note: '발행 당시 퍼센트·점수 변화·보정 ID 등 표시 데이터']
  created_at timestamptz [not null]
  shown_at timestamptz
  decided_at timestamptz
  indexes { (user_id, dedupe_key) [unique] }
}

// TU-01·02: 단일턴 QnA와 답변당 쉬운 설명 1개
Table tutor_messages [note: '일반 질문은 과거 이력 없이 호출. 쉬운 설명만 원래 문답 한 쌍을 history로 전달. 일반 멀티턴 대화 모델은 아님.'] {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  subject_id uuid [ref: > subjects.id, note: '질문 대상 과목을 지정한 경우']
  parent_message_id uuid [unique, ref: > tutor_messages.id, note: '쉬운 설명의 원래 답변. 부모당 최대 1개, 쉬운 설명의 자식 생성 금지']
  kind varchar [not null, note: 'question / simplify']
  question text [not null]
  answer text [not null, note: '검증 완료된 비어 있지 않은 답변만 저장. 대기 상태는 HTTP 요청 상태']
  is_fallback boolean [not null, default: false]
  created_at timestamptz [not null]
  answered_at timestamptz [not null]
  indexes { (user_id, created_at) }
}

Table tutor_sources {
  id uuid [pk]
  message_id uuid [not null, ref: > tutor_messages.id]
  material_id uuid [not null, ref: > materials.id]
  start_page int [not null]
  end_page int [not null]
  quote text
  indexes { message_id }
}

Table reflection_reports [note: 'AI 확인 요청 10번 구현 전제. 선택한 미완료 이유 + 기록에서 회고 생성 후 계획 조정 요청으로 연결. 월간 숫자 집계와 별개.'] {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  study_record_id uuid [ref: > study_records.id, note: '가벼운 기록 후 회고면 해당 기록 연결']
  period_start date [not null]
  period_end date [not null]
  status varchar [not null, note: 'generating / succeeded / failed']
  input_snapshot jsonb [not null, note: '분석에 사용한 기간·선택 이유·기록 ID와 당시 값']
  summary text
  suggestions jsonb [note: '탓하지 않는 문구 + 실행할 일정 조정 제안 목록']
  change_request_id uuid [ref: > plan_change_requests.id, note: '조정은 미리보기·사용자 승인 후 적용']
  is_fallback boolean [not null, default: false]
  created_at timestamptz [not null]
}

// NF / AI 확인 6~8: 공통 비동기 작업, 검증된 백업, 사용량
Table ai_saved_results [note: '시연용으로 검증한 결과·사용자 내 재사용 결과. 다른 사용자 비공개 자료를 공유 캐시로 쓰지 않음.'] {
  id uuid [pk]
  user_id uuid [ref: > users.id, note: '개인 결과 소유자. 공용 자체 제작 시연 자료만 null 허용']
  scenario_key varchar [note: 'pdf:DS / essay:DS3-06 / tutor:AVL / tutor:AVL:simplify 등']
  kind varchar [not null, note: 'pdf_analysis / question_pregenerate / plan_generate / plan_redo / quiz_generate / essay_grade / nl_parse / tutor / tutor_simplify / proposal_explain / reflection. 결과 캐시 종류이며 일반 HTTP 채팅/해석 결과도 포함']
  input_hash varchar [not null]
  schema_version varchar [not null]
  result jsonb [not null, note: '검사 완료한 도메인별 결과. 파일·페이지 참조 포함']
  validated_at timestamptz [not null]
  created_at timestamptz [not null]
  indexes { (kind, input_hash, schema_version) }
}

Table ai_jobs [note: 'question_pregenerate는 material 대상, 입력에 현재 구조 스냅샷 보존. 구조 변경과 이전 작업 취소/새 작업 생성은 같은 트랜잭션. 완료·실패·재시도 시 현재 스냅샷을 비교해 오래된 결과가 문항/준비 상태를 덮어쓰지 못하게 한다. Material.questionGenerationJobId는 현재 구조의 최신 작업에서 조회. 퀴즈 대표 채점은 kind=essay_grade,target_type=quiz_session,target_id=quiz ID로 유일; Quiz.gradingJobId는 여기서 조회. erd-constraints.sql 참조.'] {
  id uuid [pk, note: '폴링할 작업 ID']
  user_id uuid [not null, ref: > users.id]
  kind varchar [not null, note: 'pdf_analysis / question_pregenerate / plan_generate / plan_redo / quiz_generate / essay_grade / proposal_explain / reflection']
  status varchar [not null, note: 'queued / running / succeeded / failed / cancelled']
  stage varchar [note: '작업별 고정 단계. PDF: convert(필요 시) / text / outline / concepts']
  target_type varchar [note: 'material / quiz_session / quiz_attempt / change_request / reflection_report']
  target_id uuid [note: '다형 참조. FK가 아니므로 type별 대상·소유권을 서비스가 검증']
  idempotency_key varchar [not null, note: '서버가 메서드/경로/원래 키를 이름공간화한 값. 사용자 내 중복 방지. 같은 키의 다른 본문은 409']
  input_hash varchar [not null]
  input_payload jsonb [not null, note: '접수 시 원문/옵션/스키마 버전/자료 불변 버전 참조 또는 필요한 스냅샷. hash와 함께 고정 후 큐에는 job ID만 전달. 재시도·줄 단위 fallback은 이 입력 사용. 비공개; 바이너리/인증 비밀/임시 서명 URL 저장 금지']
  schema_version varchar [not null]
  result jsonb [note: '검증 성공분만. 부분 생성 JSON을 도메인 데이터로 적용하지 않음']
  saved_result_id uuid [ref: > ai_saved_results.id, note: '백업·재사용 때 사용한 결과']
  is_fallback boolean [not null, default: false]
  error_code varchar
  retry_count int [not null, default: 0, note: '형식 검사 실패 재시도 최대 1회']
  created_at timestamptz [not null]
  started_at timestamptz
  finished_at timestamptz
  indexes {
    (user_id, idempotency_key) [unique]
    (user_id, kind, status)
    input_hash
  }
}

Table ai_usage_logs [note: '실제 외부 호출마다 1행. 캐시 적중 제외. NF-07 팀 전체 예산은 내부 운영 조회·공급자 콘솔로 점검하며 학생 공개 API는 두지 않음. 상한·통화는 서버 설정.'] {
  id uuid [pk]
  job_id uuid [ref: > ai_jobs.id, note: '일반 HTTP 채팅/해석 호출이면 null']
  user_id uuid [not null, ref: > users.id]
  kind varchar [not null, note: '호출 작업 종류. 직접 채팅/해석도 비용 집계에 포함']
  provider varchar [not null]
  model varchar [not null]
  provider_request_id varchar
  input_tokens int
  output_tokens int
  estimated_cost decimal
  currency varchar [not null, default: 'USD']
  latency_ms int
  status varchar [not null, note: 'succeeded / failed']
  created_at timestamptz [not null]
  indexes { created_at }
}

