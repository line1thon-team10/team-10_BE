# 복사해서 .env로 쓰세요. .env는 깃에 올라가지 않아요.

# 로컬: 비워 두면 SQLite 파일(pirochim.db). 배포: postgresql+psycopg://사용자:비번@호스트:5432/DB이름
DATABASE_URL=

# 프론트 주소 (쉼표로 여러 개). Vercel 주소가 정해지면 추가해요
CORS_ORIGINS=http://localhost:5173

# AI 소스 위치. 비워 두면 BE에 고정된 vendor/team-10_AI submodule.
# 개발용으로만 덮어쓰세요. 상대 경로는 BE 루트 기준입니다(예: ../AI).
AI_ENGINE_PATH=

# AI가 쓰는 API 키. 깃에 올리지 말고 .env에만 넣어요
# Groq: 퀴즈 생성·채점·튜터·대화 (console.groq.com)
GROQ_API_KEY=
# Upstage: PDF 글자 추출 (team-10_AI/services/pdf_parser.py, console.upstage.ai)
UPSTAGE_API_KEY=

# 데모 기능([다음 날로], 시드 전환) 켜기
DEMO_MODE=true
